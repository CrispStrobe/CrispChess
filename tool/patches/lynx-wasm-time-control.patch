+    /// <summary>
+    /// Whether the hard time limit has been reached, read straight from
+    /// <see cref="_stopWatch"/>.
+    /// <para>
+    /// The hard limit is normally enforced by
+    /// <see cref="CancellationTokenSource.CancelAfter(int)"/>, which schedules the
+    /// cancellation on a timer. The search checks its token at every node, so
+    /// whenever that callback is late the limit is not enforced until the search
+    /// ends on its own. Under single-threaded browser WASM, where a synchronous
+    /// search leaves little room for callbacks to run, that shows up as searches
+    /// overshooting their movetime severalfold.
+    /// </para>
+    /// <para>
+    /// Reading the clock instead depends on nothing being scheduled. Measured over
+    /// ten warmed searches at a 300ms budget, median overshoot fell from 1.8-2.8x
+    /// to 1.3-1.7x and p90 from 4.7-6.8x to 1.9-2.5x. Where the timer does fire
+    /// this simply agrees with it.
+    /// </para>
+    /// </summary>
+    [MethodImpl(MethodImplOptions.AggressiveInlining)]
+    private bool IsHardTimeLimitReached() =>
+        _searchConstraints.HardLimitTimeBound != SearchConstraints.DefaultHardLimitTimeBound
+        && _stopWatch.ElapsedMilliseconds >= _searchConstraints.HardLimitTimeBound;
     private readonly Move[] _pVTable = GC.AllocateArray<Move>(Configuration.EngineSettings.MaxDepth * (Configuration.EngineSettings.MaxDepth + 1 + Constants.ArrayDepthMargin) / 2, pinned: true);
 
