app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Competitive analysis docs
docs/competitive/

# Lynx chess engine source (cloned for WASM builds, not committed)
third_party/lynx-chess/

# Claude Code working data
.claude/
.vercel
.env*.local
CLAUDE.md

# App Store Connect API key — secret, never commit
.appstoreconnect/
*.p8

# Rust build output. The wasm-bindgen output in web/ is committed (like
# web/lynx) because the web build needs it; the intermediate target/ dirs and
# the native shared libraries are not.
native/frozenight/target/
native/frozenight-wasm/target/
linux/*.so
macos/*.dylib
ios/*.a
